{
  "name": "@pelagora/pim-protocol",
  "version": "0.7.0",
  "description": "Schema.org + Reffo extension types, category schemas, and utility functions for the protocol",
  "license": "CC0-1.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./schemas/well-known/pim-discovery": "./schemas/well-known/pim-discovery.schema.json",
    "./schemas/well-known/pim-refs-feed": "./schemas/well-known/pim-refs-feed.schema.json"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ReffoAI/pim-protocol.git"
  },
  "keywords": [
    "reffo",
    "schema.org",
    "protocol",
    "p2p",
    "marketplace"
  ]
}
